{
  "name": "civora-workspace",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Independent, local-first engineering document and project delivery workspace",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "server": "node server/index.mjs",
