# Reference only. The server reads process environment; it does not auto-load .env.
HOST=127.0.0.1
PORT=8787
CIVORA_PUBLIC_ORIGIN=http://127.0.0.1:8787
CIVORA_DATA_DIR=./data
CIVORA_DB=sqlite
# Set a unique password in your deployment environment before first launch.
# CIVORA_ADMIN_PASSWORD=
# DATABASE_URL=
# OIDC_ISSUER=https://identity.example.org/realms/engineering
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Automatic jobs are enabled by default for supported uploads/check-ins.
CIVORA_AUTO_RENDITIONS=1
# CIVORA_CONVERTERS_FILE=/private/path/converters.json
# Only a NEW disposable evaluation database should use this flag:
# CIVORA_SEED_DEMO=1
# CIVORA_WORKSPACE_NAME=Engineering workspace
# CIVORA_MONGO_DATABASE=civora
# Deadline scheduler; project policies are opt-in. No email or automatic approvals.
CIVORA_AUTOMATION=1
CIVORA_AUTOMATION_INTERVAL_MS=30000
